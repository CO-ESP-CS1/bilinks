# URL de base de l'API backend (sans slash final) — obligatoire pour les données admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# JWT admin optionnel (sinon obtenu après /signin si le compte existe en base)
# Obtenir via POST /auth/password/login avec un compte role: ADMIN
NEXT_PUBLIC_ADMIN_BEARER_TOKEN=

# CORS : ajouter http://localhost:3001 dans backend/.env → CORS_ORIGINS (voir backend/.env.example)
